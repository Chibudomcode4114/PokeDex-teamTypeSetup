# Application Environment
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="PokeDex TeamTypeMatchup"

# Database Configuration (Defaults to local SQLite; compatible with PostgreSQL)
# Example PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/pokedex
DATABASE_URL=sqlite:///./pokedex.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# External PokeAPI Configuration
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_CACHE_DIR=.cache/pokeapi
POKEAPI_TIMEOUT_SECONDS=10.0
POKEAPI_MAX_RETRIES=3
POKEAPI_BACKOFF_FACTOR=0.3
